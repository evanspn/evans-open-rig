# settings-role: monitor
# Template: scripts/install.sh fills in the relative path to the agents shipped with your OpenRig install (it differs per
# machine) and composes runtime/claude-settings.fragment.json from policies/claude/rules.json for the role named above.
name: monitor
version: "1.0"
description: Oversight monitor - watches other rigs for loops, drift and token burn; nudges lightly, escalates to the human

defaults:
  runtime: claude-code
  model: claude-haiku-4-5-20251001

imports:
  - ref: local:${OPENRIG_SHARED}

profiles:
  default:
    uses:
      skills: [oversight-team, watchdog, human-in-the-loop, messaging-the-human]
      guidance: []
      subagents: []
      plugins: [shared:openrig-core]
      runtime_resources: [guard, shared:claude-activity-hooks]

resources:
  skills:
    - id: oversight-team
      path: skills/oversight-team
    - id: watchdog
      path: skills/watchdog
    - id: human-in-the-loop
      path: skills/human-in-the-loop
    - id: messaging-the-human
      path: skills/messaging-the-human
  guidance:
    - id: role
      path: guidance/role.md
  runtime_resources:
    - id: guard
      path: runtime/claude-settings.fragment.json
      runtime: claude-code
      type: claude_settings_fragment

startup:
  files:
    - path: guidance/role.md
      delivery_hint: send_text
      required: true
  actions: []
