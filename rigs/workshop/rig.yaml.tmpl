version: "0.2"
name: workshop
summary: >
  A small team: an orchestration pod with one orchestrator, an implementation pod
  with a builder and QA, a delivery pod with a PR watcher, and a security pod with
  a consulted reviewer. Work flows orchestrator -> builder -> QA -> PR watcher;
  the security reviewer is consulted on trust-boundary changes.

culture_file: CULTURE.md

# Rendered by scripts/install.sh. ${RIG_POLICY} is builtin:standard by default (builtin:open with --posture permissive).
# builtin:yolo (launch posture full_bypass) is never installed by this template; see SECURITY.md before choosing it.
permission_policy: ${RIG_POLICY}

pods:
  - id: orchestration
    label: Orchestration
    members:
      - id: orchestrator
        agent_ref: "local:${OPENRIG_AGENTS}/orchestration/orchestrator"
        runtime: claude-code
        profile: default
        cwd: "."
    edges: []

  - id: implementation
    label: Implementation
    members:
      - id: builder
        agent_ref: "local:${OPENRIG_AGENTS}/development/implementer"
        runtime: claude-code
        profile: default
        cwd: "."
      - id: qa
        agent_ref: "local:agents/qa"
        runtime: claude-code
        profile: default
        cwd: "."
    edges:
      - kind: delegates_to
        from: builder
        to: qa

  - id: delivery
    label: Delivery
    members:
      - id: pr-watcher
        agent_ref: "local:agents/pr-watcher"
        runtime: claude-code
        model: claude-haiku-4-5-20251001
        profile: default
        cwd: "."
        # read PRs and merge finished ones; the settings fragment makes it read-only otherwise
        permission_policy: builtin:locked
    edges: []

  - id: security
    label: Security
    members:
      - id: reviewer
        agent_ref: "local:agents/security-reviewer"
        runtime: claude-code
        model: claude-opus-5-5
        profile: default
        cwd: "."
        # consulted, never ships code: read-only
        permission_policy: builtin:locked
    edges: []

edges:
  - kind: delegates_to
    from: implementation.qa
    to: delivery.pr-watcher
  - kind: can_observe
    from: delivery.pr-watcher
    to: implementation.builder
  - kind: delegates_to
    from: orchestration.orchestrator
    to: implementation.builder
  - kind: delegates_to
    from: orchestration.orchestrator
    to: security.reviewer
  - kind: delegates_to
    from: implementation.builder
    to: security.reviewer
