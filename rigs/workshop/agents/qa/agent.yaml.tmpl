# settings-role: dev
# Template: scripts/install.sh fills in the relative path to the agents shipped with your OpenRig install (it differs per
# machine) and composes runtime/claude-settings.fragment.json from policies/claude/rules.json for the role named above.
name: qa
version: "1.0"
description: QA agent - verifies assigned user outcomes by effect

defaults:
  runtime: claude-code

imports:
  - ref: local:${OPENRIG_SHARED}

profiles:
  default:
    uses:
      skills: [test-driven-development, development-team, systematic-debugging, verification-before-completion, agent-browser, dogfood]
      guidance: []
      subagents: []
      plugins: [shared:openrig-core]
      runtime_resources: [shared:claude-default-settings, shared:claude-default-mcp, guard, shared:claude-activity-hooks]

resources:
  guidance:
    - id: role
      path: guidance/role.md
  runtime_resources:
    - id: guard
      path: runtime/claude-settings.fragment.json
      runtime: claude-code
      type: claude_settings_fragment

startup:
  files:
    - path: guidance/role.md
      delivery_hint: send_text
      required: true
  actions: []
